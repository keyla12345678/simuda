
/* =========================
   PENGATURAN DASAR
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f3f7fc;
    color: #26364a;
    line-height: 1.6;
}

html {
    scroll-behavior: smooth;
}

/* =========================
   LOGIN DAN REGISTRASI
========================= */

.halaman-login,
.halaman-registrasi {
    background: white;
    width: 90%;
    max-width: 430px;
    margin: 60px auto;
    padding: 35px 30px;
    border-radius: 18px;
    box-shadow: 0 8px 30px rgba(23, 105, 170, 0.10);
}

.halaman-login h1,
.halaman-registrasi h1 {
    color: #1769aa;
    text-align: center;
    margin-bottom: 10px;
    font-size: 27px;
}

.halaman-login p,
.halaman-registrasi p {
    text-align: center;
    color: #718096;
    margin-bottom: 22px;
}

/* =========================
   FORMULIR
========================= */

form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

label {
    font-weight: bold;
    font-size: 14px;
    margin-top: 5px;
    color: #34445a;
}

input,
textarea,
select {
    width: 100%;
    padding: 13px 14px;
    border: 1px solid #d5deea;
    border-radius: 10px;
    font-size: 14px;
    font-family: Arial, sans-serif;
    background: #fbfdff;
    color: #26364a;
    transition: 0.2s;
}

input:focus,
textarea:focus,
select:focus {
    outline: none;
    border-color: #258bd1;
    box-shadow: 0 0 0 3px rgba(37, 139, 209, 0.12);
}

input[readonly] {
    background: #edf3f9;
    color: #65758a;
}

textarea {
    min-height: 100px;
    resize: vertical;
}

/* =========================
   TOMBOL
========================= */

button {
    background: #1769aa;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 10px;
    margin-top: 12px;
    font-size: 14px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.25s;
}

button:hover {
    background: #10558d;
    transform: translateY(-2px);
}

button:active {
    transform: scale(0.98);
}

/* =========================
   HEADER BERANDA
========================= */

header {
    background: linear-gradient(135deg, #145b96, #258bd1);
    color: white;
    padding: 35px 20px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(23, 105, 170, 0.15);
}

header h1 {
    font-size: 34px;
    letter-spacing: 1px;
    margin-bottom: 5px;
}

header p {
    color: #e8f4ff;
    font-size: 14px;
}

header button {
    background: white;
    color: #1769aa;
    padding: 10px 18px;
    border-radius: 20px;
    margin-top: 18px;
}

header button:hover {
    background: #e8f4ff;
    color: #10558d;
}

/* =========================
   KONTEN UTAMA
========================= */

main {
    padding: 30px 20px;
    max-width: 1100px;
    margin: auto;
}

.welcome {
    background: linear-gradient(120deg, #ffffff, #eaf5ff);
    padding: 32px;
    border-radius: 18px;
    margin-bottom: 30px;
    border: 1px solid #e0edf8;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.04);
}

.welcome h2 {
    color: #1769aa;
    margin-bottom: 8px;
    font-size: 23px;
}

.welcome p {
    color: #65758a;
}

/* =========================
   KATEGORI LAYANAN
========================= */

.kategori h2 {
    color: #26364a;
    margin-bottom: 18px;
    font-size: 22px;
}

.daftar-kategori {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.item {
    background: white;
    padding: 27px 12px;
    text-align: center;
    border-radius: 16px;
    font-size: 30px;
    border: 1px solid #e4edf7;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
    transition: 0.25s;
}

.item:hover {
    transform: translateY(-5px);
    background: #f0f8ff;
    border-color: #b9dcf5;
    box-shadow: 0 8px 20px rgba(23, 105, 170, 0.10);
}

.item p {
    font-size: 14px;
    margin-top: 8px;
    font-weight: bold;
    color: #34445a;
}

/* =========================
   DAFTAR PRODUK
========================= */

.daftar-produk {
    background: white;
    padding: 28px;
    margin: 28px auto;
    max-width: 1100px;
    border-radius: 18px;
    border: 1px solid #e4edf7;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.05);
}

.daftar-produk h2 {
    color: #1769aa;
    margin-bottom: 10px;
    font-size: 23px;
}

.daftar-produk > p {
    color: #718096;
    margin-bottom: 22px;
}

.isi-produk {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 22px;
}

.kartu-produk {
    background: #f8fbff;
    border: 1px solid #e0eaf5;
    padding: 20px;
    border-radius: 15px;
    transition: 0.25s;
}

.kartu-produk:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.07);
}

.kartu-produk h3 {
    color: #263b50;
    margin-bottom: 10px;
    font-size: 17px;
}

.kartu-produk p {
    color: #16834a;
    font-weight: bold;
    margin-bottom: 14px;
}

.kartu-produk button {
    width: 100%;
    background: #1769aa;
    color: white;
    border-radius: 9px;
}

.kartu-produk button:hover {
    background: #105487;
}

/* =========================
   FOTO PRODUK
========================= */

.foto-produk {
    width: 100%;
    height: 185px;
    object-fit: contain;
    margin-bottom: 15px;
    border-radius: 10px;
    background: white;
}

/* =========================
   KERANJANG DAN STATUS
========================= */

#halamanKeranjang,
#halamanStatus {
    background: white;
    padding: 28px;
    margin: 28px auto;
    max-width: 1100px;
    border-radius: 18px;
    border: 1px solid #e4edf7;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.05);
}

#halamanKeranjang h2,
#halamanStatus h2 {
    color: #1769aa;
    margin-bottom: 12px;
}

#isiKeranjang {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin: 20px 0;
}

#totalKeranjang {
    color: #16834a;
    margin: 18px 0;
}

/* =========================
   FORMULIR PEMESANAN
========================= */

.pesanan {
    background: white;
    padding: 30px;
    margin-top: 30px;
    border-radius: 18px;
    border: 1px solid #e4edf7;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.05);
}

.pesanan h2 {
    color: #1769aa;
    margin-bottom: 8px;
    font-size: 23px;
}

.pesanan > p {
    color: #718096;
    margin-bottom: 20px;
}

/* =========================
   FOOTER
========================= */

footer {
    text-align: center;
    padding: 25px 15px;
    margin-top: 35px;
    background: #eaf2fa;
    color: #65758a;
    font-size: 13px;
}

/* =========================
   TAMPILAN HP
========================= */

@media (max-width: 600px) {

    .halaman-login,
    .halaman-registrasi {
        margin: 35px auto;
        padding: 25px 20px;
    }

    header {
        padding: 25px 15px;
    }

    header h1 {
        font-size: 28px;
    }

    main {
        padding: 20px 15px;
    }

    .daftar-kategori {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .item {
        padding: 20px 8px;
    }

    .welcome,
    .pesanan,
    .daftar-produk,
    #halamanKeranjang,
    #halamanStatus {
        padding: 20px;
    }

    .isi-produk,
    #isiKeranjang {
        grid-template-columns: 1fr;
    }

    button {
        width: 100%;
    }

    header button {
        width: auto;
    }

    .foto-produk {
        height: 170px;
    }
}
